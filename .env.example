# AgentForge Multi-Agent Platform 配置
# 可以在此处或 agentforge_config.json 中配置

# 首选主模型 API Key 与 Base URL (可选，优先读取 agentforge_config.json)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 默认工作区与沙箱设置
AGENTFORGE_WORKSPACE=测试软件
AGENTFORGE_MAX_LOOPS=10
AGENTFORGE_COMMAND_TIMEOUT=60
