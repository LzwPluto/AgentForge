# OpenCode Multi-Agent Platform 配置
# 支持任意兼容 OpenAI 接口的模型端点 (DeepSeek, OpenAI, Qwen, Ollama, Claude 转发等)

# LLM API 密钥
OPENAI_API_KEY=sk-your-api-key-here

# LLM API 基础地址 (例如 DeepSeek: https://api.deepseek.com/v1 或 Qwen/OpenAI 兼容端点)
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 默认模型名称 (例如 deepseek-chat, deepseek-reasoner, gpt-4o, qwen-max 等)
DEFAULT_MODEL=deepseek-chat

# 主持人 (Tech Lead) 模型 (可选，留空则默认使用 DEFAULT_MODEL)
LEAD_MODEL=

# 代码专家 (Coder) 模型 (可选，留空则默认使用 DEFAULT_MODEL)
CODER_MODEL=

# 工作区沙箱根路径 (留空默认为当前项目目录)
WORKSPACE_ROOT=

# 最大思考/执行循环轮数
MAX_LOOPS_PER_TASK=15

# 工具执行超时时间 (秒)
COMMAND_TIMEOUT_SECONDS=60
