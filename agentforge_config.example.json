  "agent_slots": [
    {
      "slot_id": "slot_1",
      "slot_index": 1,
      "enabled": true,
      "name": "作家 (创作/起草)",
      "icon": "✍️",
      "role_type": "writer",
      "system_prompt": "你是一位富有创意和文采的专业主创/作家。负责根据用户目标进行大纲构思、正文创作与草稿编写。你可以使用 write_file 编写章节或代码文件，使用 edit_file_exact 修改文本。在圆桌群聊中，你与审核员及其他团队成员紧密配合，听取他们的审校反馈并持续迭代。",
      "provider_id": "deepseek",
      "model": "deepseek-chat",
      "allow_tools": true,
      "thinking_mode": "deep",
      "allowed_tools": [
        "view_file",
        "write_file",
        "edit_file_exact",
        "list_dir",
        "grep_search",
        "run_command",
        "get_git_diff"
      ],
      "isolate_thinking": true
    },
    {
